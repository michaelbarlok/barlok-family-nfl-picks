# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Gmail (for weekly email)
GMAIL_ADDRESS=your-email@gmail.com
GMAIL_APP_PASSWORD=your-16-char-app-password

# Vercel Cron (auto-set by Vercel, or set manually for local testing)
CRON_SECRET=your-cron-secret

# Web Push — powers 💩 Talk notifications (opt-in, per device)
# Generate a pair once with:  npx web-push generate-vapid-keys
# Changing these invalidates every existing subscription, so everyone would
# have to turn notifications on again. Leave unset to run without push.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:barlokmichael@gmail.com
